# .env.example — PaperPilot 环境变量模板
#
# 本文件只含配置名，不含真实密钥。按需复制为 .env 并填写真实值：
#   cp .env.example .env
#
# 使用方式:
#   - Docker Compose    自动读取仓库根目录 .env（MYSQL_ROOT_PASSWORD 等）
#   - Java API (Spring Boot) 密钥来自环境变量或 application-local.yml（gitignored）
#   - Python Worker     读取 paperpilot-agent/.env（gitignored），需设置 OPENAI_API_KEY

# ── Docker Compose ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me
#   ^ MySQL root 密码。真实值只放在 gitignored 的 .env 中。

# ── Java API (Spring Boot) ─────────────────────────────────────
# application.yml 中的 ${MYSQL_URL} 等占位符；本地通常直接写在
# paperpilot-api/src/main/resources/application-local.yml（gitignored）。
MYSQL_URL=jdbc:mysql://localhost:3306/paperpilot?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
#   ^ 与 MYSQL_ROOT_PASSWORD 保持一致
REDIS_HOST=localhost
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=localhost:9876
AGENT_WORKER_URL=http://localhost:8001
#   ^ Python Worker 地址，对应 paperpilot.worker.base-url

# ── Python Worker (paperpilot-agent/.env) ──────────────────────
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
#   ^ 必填：真实 API Key 只放在 gitignored 的 .env 中
OPENAI_MODEL=deepseek-chat
CHROMA_HOST=localhost
CHROMA_PORT=8000
GROBID_URL=http://localhost:8070
ROCKETMQ_NAMESRV=localhost:9876
WORK_DIR=/tmp/paperpilot
