# PaperPilot .gitignore
docs/
# Java / Maven
**/target/
**/.mvn/wrapper/
**/mvnw
**/mvnw.cmd
*.class
*.jar
*.war

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/
*.so

# 本地论文原文（基准只提交来源、版本与 checksum，不提交 PDF）
paperpilot-agent/data/papers/*.pdf

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Environment
.env
.env.local

# Spring Boot local profile（含本地密钥，不入库）
**/application-local.yml

# Docker volumes
mysql_data/
chroma_data/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
.e2e-artifacts/

# Temp
/tmp/
*.tmp
